{
  "name": "lectures",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=dev.env --env-file-if-exists=.env --watch --watch-preserve-output --import tsx src/index.ts",
    "ingest": "node --env-file-if-exists=dev.env --env-file-if-exists=.env --import tsx src/ingest/cli.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "node-html-parser": "^9.0.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
